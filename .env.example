POSTGRES_DB=betalab
POSTGRES_USER=betalab
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
REGISTRATION_ENABLED=true
COOKIE_SECURE=false
# Exact frontend origins; add the actual LAN origin when demonstrating.
APP_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_SECONDS=90

# C: real Trial2 preview jobs; mock is an explicit development/test mode.
COMPUTE_MODE=real
COMPUTE_STORAGE_DIR=./data/compute
COMPUTE_TIMEOUT_SECONDS=1800
# Required for real worker; point to the local verified CIS5810 checkout.
BETA_TRANSLATOR_ROOT="/path/to/CIS 5810/Beta_Translator"
# Optional override; otherwise uses $BETA_TRANSLATOR_ROOT/.venv/bin/python.
# BETA_TRANSLATOR_PYTHON="/path/to/python"

# Prepared demos never run computation from the browser. Offline CLI is also off by default.
BETALAB_DEMO_COMPUTE_ENABLED=0
